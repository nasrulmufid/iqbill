APP_NAME="IQ Bill"
APP_TAGLINE="Billing RT/RW Net & Management PPPOE Mikrotik REST API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://billing.example.com
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database (MySQL 8.0 service in docker-compose.yml uses host "db")
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=iqbill
DB_USERNAME=iqbill
DB_PASSWORD=change_me_strong_db_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# Sessions, Cache & Queue (Redis service in docker-compose.yml uses host "redis")
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=iqbill_
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_PORT=6379

# Reverse proxy configuration (set specific proxy IPs or * behind trusted Cloudflare/Nginx)
TRUSTED_PROXIES=*

# Initial administrator credentials & company defaults (used on first database seed)
ADMIN_EMAIL=admin@iqbill.local
ADMIN_PASSWORD=change_me_min_12_chars
ADMIN_PHONE=6281100000000
ISP_COMPANY_NAME="IQ Bill"
ISP_COMPANY_ADDRESS="Jl. Jend. Sudirman No. 1, Jakarta"
ISP_COMPANY_PHONE=6281100000001

# Docker container startup automation
AUTO_MIGRATE=true
AUTO_SEED=true

# Bundled Go-WhatsApp (GOWA) container & automatic IQ Bill integration
GOWA_API_URL=http://gowa:3000
GOWA_BASIC_AUTH_USER=iqbill
GOWA_BASIC_AUTH_PASSWORD=change_me_gowa_password
GOWA_DEVICE_ID=
GOWA_DEVICE_OS="IQ Bill"
GOWA_ACCOUNT_VALIDATION=false
GOWA_HOST_BIND=127.0.0.1
GOWA_HOST_PORT=3000
GOWA_AUTO_SYNC=true
GOWA_FORCE_SYNC=false
